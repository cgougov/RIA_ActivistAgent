    "notes": [
      {
        "field_key": "neutral_summary",
        "label": "Neutral summary",
        "value": "Begonia Capital proposes a Japan Equity Long-Only Engagement Fund focused on concentrated, engagement-driven investments in Japanese public equities, targeting initial AUM of USD 10–50 million with an expected launch in May 2024. Disclosed terms include a 3-year lock-up with 1.5% management and 17% performance fees (high-water mark), quarterly redemptions with 90-day notice, and a 20% fund-level gate.",
        "value_num": null,
        "unit": "null",
        "as_of_date": null,
        "source": {
          "doc_id": "doc_012",
          "page": 3,
          "quote": "Japan Equity Long-Only Engagement Fund … Initial AUM USD 10-50 million … Expected Launch May 2024"
        }
      },
      {
        "field_key": "differentiating_edge",
        "label": "Differentiating edge",
        "value": "The PM, Bryan Kazuya Mori, is bilingual and bicultural with rare experience across both Japanese and foreign activist/engagement approaches (e.g., Ichigo and King Street), positioning the fund to blend respectful, long‑term engagement with effective activism in Japan; the strategy also intends to leverage smaller AUM to focus on underfollowed opportunities.",
        "value_num": null,
        "unit": "null",
        "as_of_date": null,
        "source": {
          "doc_id": "doc_012",
          "page": 13,
          "quote": "Bryan Kazuya Mori has the exceedingly rare experience of working at 2 funds involved in the Japanese engagement/activist scene that take very different approaches… This expertise, coupled with cultural and language fluency, puts him in a league of his own"
        }
      },
      {
        "field_key": "data_limitations",
        "label": "Data limitations",
        "value": "This is a pre‑launch presentation; key details are deferred to formal fund documents and some service providers are not finalized. No audited, fund‑level performance history or benchmark is presented.",
        "value_num": null,
        "unit": "null",
        "as_of_date": null,
        "source": {
          "doc_id": "doc_012",
          "page": 18,
          "quote": "This presentation does not purport to replace any managed account and or fund offer documents but is to be used for explanatory purposes only."
        }
      }
    ],
