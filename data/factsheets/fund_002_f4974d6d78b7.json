    "notes": [
      {
        "field_key": "neutral_summary",
        "label": "Neutral summary",
        "value": "Simplex Value Up Strategy is a Japan-focused, friendly activist equity strategy that builds a diversified portfolio mainly in listed small- and mid-cap companies and seeks consistently strong absolute returns with reduced volatility, correlation, and losses. Managed by Simplex Asset Management in Tokyo, it reports strategy AUM of $1.6 billion as of September 30, 2025, shows long-running USD (with FX hedge) and JPY share classes (ITD 564.10% and 400.88%, respectively), and presents performance after fees (1.5% management; 20% incentive).",
        "value_num": null,
        "unit": "null",
        "as_of_date": "2025-09-30",
        "source": {
          "doc_id": "doc_003",
          "page": 1,
          "quote": "The Simplex Value Up Strategy seeks to achieve consistently strong absolute returns with reduced volatility, correlation, and losses. The strategy invests in Japanese companies using a friendly activist approach."
        }
      },
      {
        "field_key": "differentiating_edge",
        "label": "Differentiating edge",
        "value": "The strategy applies a friendly activist approach that actively persuades management teams to unlock shareholder value through operational and financial engineering and specific actions like M&A or share buybacks, while maintaining constructive relationships.",
        "value_num": null,
        "unit": "null",
        "as_of_date": null,
        "source": {
          "doc_id": "doc_003",
          "page": 1,
          "quote": "The investment style focuses on finding companies with management willing to unlock shareholder value through operational and financial engineering. The strategy actively persuades management to implement shareholder-friendly actions, such as M&As or share buybacks, while maintaining a constructive relationship."
        }
      },
      {
        "field_key": "data_limitations",
        "label": "Data limitations",
        "value": "Performance is presented for a “Sample Portfolio,” and key operating conditions are left blank; returns prior to Oct 2007 for the USD (with FX hedge) series are estimated from an unhedged class. Important details about how the Sample Portfolio maps to investable vehicles and full subscription/redemption terms are not provided.",
        "value_num": null,
        "unit": "null",
        "as_of_date": null,
        "source": {
          "doc_id": "doc_003",
          "page": 1,
          "quote": "The performance and data presented pertain to a portfolio managed by SAM, utilizing the Strategy (\"Sample Portfolio\")."
        }
      }
